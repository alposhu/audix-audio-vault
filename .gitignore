# Python
__pycache__/
*.py[cod]
*.egg-info/

# Build output (PyInstaller writes both)
build/
dist/

# Generated by packaging/make_icon.py on every build.
# NOTE: git has no inline comments - a trailing "# ..." on a pattern line
# becomes part of the pattern and silently matches nothing.
packaging/audix.ico

# Virtual environments
.venv/
venv/
env/

# audix runtime data (also lives in ~/.audix, but never commit a local copy)
.audix/
cookies.txt
*.log

# Secrets. audix needs none of these, but the cost of a stray commit is high
# enough that they are excluded pre-emptively.
.env
.env.*
*.env
secrets.json
*.pem
*.key
*.p12
*.pfx
credentials.json
.netrc

# Design review captures. Regenerated on every run, and full of local paths.
.impeccable/review/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
